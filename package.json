{
  "name": "procedural-worlds",
  "version": "1.0.0",
  "description": "Procedural Worlds",
  "license": "MIT",
  "author": "Bhupendra Bhudia",
  "homepage": "https://github.com/bhudiaxyz/procedural-worlds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhudiaxyz/procedural-worlds.git"
  },
  "bugs": {
    "url": "https://github.com/bhudiaxyz/procedural-worlds/issues"
  },
  "main": "./src/ts/index.ts",
  "scripts": {
    "build": "webpack --progress --mode production --config webpack.config.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "cross-env NODE_ENV=dev webpack serve --progress --open --config webpack.config.js",
    "lint": "eslint src/ts",
    "lint:fix": "npm run lint -- --fix",
    "start": "npm run dev",
    "watch": "npm run dev",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "alea": "^1.0.0",
    "bootstrap": "^5.3.8",
    "lil-gui": "^0.21.0",
    "load-img": "^1.0.0",
    "random-lorem": "^1.0.4",
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3",
    "stats.js": "^0.17.0",
    "three": "^0.186.1",
    "webvr-polyfill": "^0.10.12",
    "webvr-ui": "^0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.40.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.0",
    "gh-pages": "^6.3.0",
    "glob": "^14.0.3",
    "glsl-aastep": "^1.0.1",
    "glsl-atmosphere": "^2.0.0",
    "glsl-blend": "^1.0.3",
    "glsl-diffuse-lambert": "^1.0.0",
    "glsl-dither": "^1.0.1",
    "glsl-hsl2rgb": "^1.1.0",
    "glsl-noise": "^0.0.0",
    "glsl-pi": "^1.0.0",
    "glsl-worley": "^1.0.2",
    "glslify": "^7.1.1",
    "glslify-hex": "^2.1.1",
    "glslify-loader": "^2.0.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "ify-loader": "^1.0.4",
    "lint-staged": "^17.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "nice-color-palettes": "^4.0.0",
    "parse-color": "^1.0.0",
    "prettier": "^3.5.0",
    "raw-loader": "^4.0.2",
    "sass": "^1.106.1",
    "sass-loader": "^17.1.0",
    "terser-webpack-plugin": "^5.3.11",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "worley-noise": "^2.0.1"
  },
  "keywords": [
    "babel",
    "computer",
    "es6",
    "generated",
    "graphics",
    "noise",
    "opengl",
    "perlin",
    "planet",
    "procedural",
    "sass",
    "three",
    "threejs",
    "webgl",
    "webpack",
    "world"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "package.json": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "semistandard": {
    "globals": [
      "THREE"
    ]
  },
  "title": "Procedural World",
  "allowScripts": {
    "mozjpeg@6.0.1": true,
    "cwebp-bin@5.1.0": true,
    "gifsicle@4.0.1": true,
    "optipng-bin@6.0.0": true,
    "pngquant-bin@5.0.2": true,
    "core-js@3.51.0": true,
    "@parcel/watcher@2.6.0": true
  }
}
